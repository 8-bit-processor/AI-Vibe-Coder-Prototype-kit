import tkinter as tk
import random
import time

class SpaceInvaders:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Space Invaders")
        self.root.resizable(False, False)
        
        # Game settings
        self.canvas_width = 800
        self.canvas_height = 600
        self.canvas = tk.Canvas(self.root, width=self.canvas_width, height=self.canvas_height, bg="black")
        self.canvas.pack()
        
        # Game state
        self.score = 0
        self.lives = 3
        self.level = 1
        self.game_over = False
        self.paused = False
        
        # Player
        self.player_width = 50
        self.player_height = 20
        self.player_x = self.canvas_width // 2 - self.player_width // 2
        self.player_y = self.canvas_height - 50
        self.player_speed = 7
        self.player = self.canvas.create_rectangle(
            self.player_x, self.player_y,
            self.player_x + self.player_width, self.player_y + self.player_height,
            fill="blue", outline="white"
        )
        
        # Invaders
        self.invaders = []
        self.invader_rows = 5
        self.invader_cols = 10
        self.invader_width = 40
        self.invader_height = 30
        self.invader_spacing = 15
        self.invader_speed = 1
        self.invader_direction = 1  # 1 for right, -1 for left
        self.invader_move_down = False
        self.last_invader_move_time = 0
        self.invader_move_delay = 500  # milliseconds
        
        # Bullets
        self.bullets = []
        self.bullet_speed = 8
        self.bullet_cooldown = 0
        self.bullet_cooldown_time = 200  # milliseconds
        
        # Create invaders
        self.create_invaders()
        
        # Score and lives display
        self.score_text = self.canvas.create_text(
            100, 30, text=f"Score: {self.score}", fill="white", font=("Arial", 16)
        )
        self.lives_text = self.canvas.create_text(
            700, 30, text=f"Lives: {self.lives}", fill="white", font=("Arial", 16)
        )
        self.level_text = self.canvas.create_text(
            400, 30, text=f"Level: {self.level}", fill="white", font=("Arial", 16)
        )
        
        # Controls
        self.root.bind("<Left>", self.move_left)
        self.root.bind("<Right>", self.move_right)
        self.root.bind("<space>", self.shoot)
        self.root.bind("<p>", self.toggle_pause)
        self.root.bind("<r>", self.restart_game)
        
        # Start game loop
        self.root.after(1, self.update)
        
    def create_invaders(self):
        """Create invaders in a grid pattern"""
        start_x = (self.canvas_width - (self.invader_cols * (self.invader_width + self.invader_spacing))) // 2
        start_y = 50
        
        for row in range(self.invader_rows):
            row_invaders = []
            for col in range(self.invader_cols):
                x1 = start_x + col * (self.invader_width + self.invader_spacing)
                y1 = start_y + row * (self.invader_height + self.invader_spacing)
                x2 = x1 + self.invader_width
                y2 = y1 + self.invader_height
                
                # Different colors for different rows
                colors = ["red", "orange", "yellow", "green", "blue"]
                color = colors[row % len(colors)]
                
                invader = self.canvas.create_rectangle(
                    x1, y1, x2, y2, fill=color, outline="white"
                )
                row_invaders.append(invader)
            self.invaders.append(row_invaders)
    
    def move_left(self, event):
        """Move player left"""
        if self.game_over or self.paused:
            return
        coords = self.canvas.coords(self.player)
        if coords[0] > 0:
            self.canvas.move(self.player, -self.player_speed, 0)
    
    def move_right(self, event):
        """Move player right"""
        if self.game_over or self.paused:
            return
        coords = self.canvas.coords(self.player)
        if coords[2] < self.canvas_width:
            self.canvas.move(self.player, self.player_speed, 0)
    
    def shoot(self, event):
        """Shoot a bullet"""
        if self.game_over or self.paused:
            return
            
        current_time = time.time() * 1000
        if current_time - self.bullet_cooldown < self.bullet_cooldown_time:
            return
            
        self.bullet_cooldown = current_time
        
        coords = self.canvas.coords(self.player)
        bullet_x = (coords[0] + coords[2]) // 2
        bullet_y = coords[1]
        
        bullet = self.canvas.create_rectangle(
            bullet_x - 3, bullet_y - 10,
            bullet_x + 3, bullet_y,
            fill="white"
        )
        self.bullets.append(bullet)
    
    def toggle_pause(self, event):
        """Toggle pause state"""
        if self.game_over:
            return
        self.paused = not self.paused
        if not self.paused:
            self.root.after(1, self.update)
    
    def restart_game(self, event):
        """Restart the game"""
        self.restart()
    
    def restart(self):
        """Reset game state"""
        # Clear existing game objects
        for invader_row in self.invaders:
            for invader in invader_row:
                self.canvas.delete(invader)
        for bullet in self.bullets:
            self.canvas.delete(bullet)
        
        # Reset game state
        self.score = 0
        self.lives = 3
        self.level = 1
        self.game_over = False
        self.paused = False
        self.invader_direction = 1
        self.invader_speed = 1
        self.bullets = []
        self.bullet_cooldown = 0
        
        # Reset player position
        self.canvas.coords(self.player, 
                          self.canvas_width // 2 - self.player_width // 2,
                          self.canvas_height - 50,
                          self.canvas_width // 2 + self.player_width // 2,
                          self.canvas_height - 30)
        
        # Recreate invaders
        self.create_invaders()
        
        # Update display
        self.canvas.itemconfig(self.score_text, text=f"Score: {self.score}")
        self.canvas.itemconfig(self.lives_text, text=f"Lives: {self.lives}")
        self.canvas.itemconfig(self.level_text, text=f"Level: {self.level}")
        
        # Start game loop
        self.root.after(1, self.update)
    
    def update(self):
        """Main game update loop"""
        if self.game_over or self.paused:
            if not self.game_over:
                self.root.after(100, self.update)
            return
        
        # Move invaders
        self.move_invaders()
        
        # Move bullets
        self.move_bullets()
        
        # Check collisions
        self.check_collisions()
        
        # Check if level complete
        self.check_level_complete()
        
        # Continue game loop
        self.root.after(10, self.update)
    
    def move_invaders(self):
        """Move invaders and handle direction changes"""
        current_time = time.time() * 1000
        
        if current_time - self.last_invader_move_time < self.invader_move_delay:
            return
            
        self.last_invader_move_time = current_time
        
        # Check if any invader hits the edge
        move_down = False
        for row in self.invaders:
            for invader in row:
                coords = self.canvas.coords(invader)
                if (coords[2] >= self.canvas_width and self.invader_direction == 1) or \
                   (coords[0] <= 0 and self.invader_direction == -1):
                    move_down = True
                    break
            if move_down:
                break
        
        # Move invaders
        for row in self.invaders:
            for invader in row:
                if move_down:
                    self.canvas.move(invader, 0, self.invader_height // 2)
                else:
                    self.canvas.move(invader, self.invader_speed * self.invader_direction, 0)
        
        # Change direction if needed
        if move_down:
            self.invader_direction *= -1
    
    def move_bullets(self):
        """Move all bullets"""
        for bullet in self.bullets[:]:
            self.canvas.move(bullet, 0, -self.bullet_speed)
            coords = self.canvas.coords(bullet)
            # Remove bullets that go off screen
            if coords[1] < 0:
                self.canvas.delete(bullet)
                self.bullets.remove(bullet)
    
    def check_collisions(self):
        """Check for bullet-invader and player-invader collisions"""
        # Bullet-invader collisions
        for bullet in self.bullets[:]:
            bullet_coords = self.canvas.coords(bullet)
            bullet_center_x = (bullet_coords[0] + bullet_coords[2]) / 2
            bullet_center_y = (bullet_coords[1] + bullet_coords[3]) / 2
            
            for row in self.invaders[:]:
                for invader in row[:]:
                    invader_coords = self.canvas.coords(invader)
                    invader_center_x = (invader_coords[0] + invader_coords[2]) / 2
                    invader_center_y = (invader_coords[1] + invader_coords[3]) / 2
                    
                    # Simple distance-based collision detection
                    distance = ((bullet_center_x - invader_center_x) ** 2 + 
                               (bullet_center_y - invader_center_y) ** 2) ** 0.5
                    
                    if distance < (self.invader_width + 10) / 2:
                        # Collision detected
                        self.canvas.delete(bullet)
                        self.bullets.remove(bullet)
                        self.canvas.delete(invader)
                        row.remove(invader)
                        
                        # Update score
                        self.score += 10
                        self.canvas.itemconfig(self.score_text, text=f"Score: {self.score}")
                        
                        break
                else:
                    continue
                break
        
        # Player-invader collisions
        player_coords = self.canvas.coords(self.player)
        for row in self.invaders[:]:
            for invader in row[:]:
                invader_coords = self.canvas.coords(invader)
                
                # Simple collision detection
                if (player_coords[0] < invader_coords[2] and 
                    player_coords[2] > invader_coords[0] and
                    player_coords[1] < invader_coords[3] and
                    player_coords[3] > invader_coords[1]):
                    
                    # Collision with player
                    self.lives -= 1
                    self.canvas.itemconfig(self.lives_text, text=f"Lives: {self.lives}")
                    self.canvas.delete(invader)
                    row.remove(invader)
                    
                    # Reset invader position
                    self.canvas.coords(self.player, 
                                      self.canvas_width // 2 - self.player_width // 2,
                                      self.canvas_height - 50,
                                      self.canvas_width // 2 + self.player_width // 2,
                                      self.canvas_height - 30)
                    
                    if self.lives <= 0:
                        self.game_over = True
                        self.canvas.create_text(
                            self.canvas_width // 2, self.canvas_height // 2,
                            text="GAME OVER", fill="red", font=("Arial", 32, "bold")
                        )
                        self.canvas.create_text(
                            self.canvas_width // 2, self.canvas_height // 2 + 50,
                            text="Press 'R' to restart", fill="white", font=("Arial", 16)
                        )
                    break
            else:
                continue
            break
    
    def check_level_complete(self):
        """Check if all invaders are destroyed"""
        if all(len(row) == 0 for row in self.invaders):
            # Level complete
            self.level += 1
            self.canvas.itemconfig(self.level_text, text=f"Level: {self.level}")
            
            # Increase difficulty
            self.invader_speed += 0.2
            self.invader_move_delay = max(100, self.invader_move_delay - 50)
            
            # Reset invaders
            self.invaders = []
            self.create_invaders()
    
    def run(self):
        """Start the game"""
        # Add instructions
        self.canvas.create_text(
            self.canvas_width // 2, self.canvas_height - 20,
            text="Use ← → to move, SPACE to shoot, P to pause, R to restart",
            fill="white", font=("Arial", 12)
        )
        self.root.mainloop()

if __name__ == "__main__":
    game = SpaceInvaders()
    game.run()
